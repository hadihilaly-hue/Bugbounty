# Copy to .env (gitignored). All guardrails default safe; override with care.

# Reasoning layer (Phase 3+). Keep out of the repo; provided via Devin secret.
ANTHROPIC_API_KEY=

# Safety guardrails
DRY_RUN=true                 # true = recon/static/reasoning only, NO active payloads
BB_KILL_SWITCH=false         # true = refuse all active payloads regardless of other flags

# Concurrency / rate limiting
BB_CONCURRENCY=10
BB_REQUESTS_PER_SECOND=2.0

# Per-run budget caps (run aborts when any is hit)
BB_MAX_TOKENS=2000000
BB_MAX_REQUESTS=5000
BB_MAX_WALL_CLOCK_SECONDS=10800
BB_MAX_USD=10.0
