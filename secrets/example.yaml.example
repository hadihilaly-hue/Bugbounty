# Copy to secrets/<target>.yaml (gitignored) and fill in per-target creds.
# The target's auth.login block in targets.yaml says HOW to log in; this file is
# WHO to log in as. Two accounts enable the IDOR/access-control two-account test.
# Nothing in secrets/ is ever committed (see .gitignore).

# --- Username/password accounts (used with auth.login mode: form | json) ---
accounts:
  - label: "account_a"
    username: "user_a@example.com"   # or `email:` — both accepted
    password: "REPLACE_ME"
  - label: "account_b"
    username: "user_b@example.com"
    password: "REPLACE_ME"

# --- Handed-in live session (OAuth / SSO / MFA / anti-bot path) ---
# If headless login is blocked, or the target needs MFA (which we never automate
# or fake), log in yourself in a real browser and paste the live session here.
# When present, the agent uses it directly and SKIPS the login request. The
# session is origin-pinned (scheme+host+port) and is carried into BOTH the HTTP
# proof harnesses AND the XSS render navigation, so post-auth tests
# (IDOR/BOLA, auth-gated stored XSS) finally run. Set it per-account (preferred,
# so the two-account IDOR test has two real sessions) or shared at the top level.
#
# Two handed-in accounts for the IDOR/BOLA two-account test:
# accounts:
#   - label: "account_a"               # attacker
#     cookies:
#       - {name: "session", value: "LIVE_A", domain: "app.example.com", path: "/"}
#   - label: "account_b"               # victim
#     cookies:
#       - {name: "session", value: "LIVE_B", domain: "app.example.com", path: "/"}
#
# Other handed-in forms (per-account or shared):
# bearer_token: "LIVE_JWT"             # token/JWT APIs instead of cookies
# cookies: {session: "LIVE"}           # mapping form also accepted
# local_storage:                       # SPA apps that read their token from
#   token: "LIVE_JWT"                  # localStorage (e.g. Juice Shop) — seeded
#   # ...                              # into the browser for the XSS render only
#
# Validity: if a handed-in session is expired/invalid, the harness surfaces it
# loudly (UNCONFIRMED with a clear reason) rather than running unauthenticated
# and reporting nothing — hand in a fresh session.
#
# MFA note: if a target needs MFA, set `auth.mfa_required: true` (or a
# login.mfa_marker / mfa_status) in targets.yaml. The session manager then
# stops and surfaces it to you rather than guessing — supply a live session
# above to proceed.
